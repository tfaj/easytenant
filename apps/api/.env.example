# Copy to apps/api/.env for local development. Never commit the real file.
PORT=8787
NODE_ENV=development

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME=easytenant

# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGINS=http://localhost:5173
# Used to build links in emails (invites, notifications).
PUBLIC_WEB_URL=http://localhost:5173

# Firebase project id. On Cloud Run in the same GCP project, no key is
# needed at all. Elsewhere, also set FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Email (optional). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="EasyTenant <notifications@easytenant.ng>"

# Cloudflare R2 (S3-compatible API) for photos and videos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=easytenant-media

# Shared secret Cloud Scheduler sends to /internal/jobs/*.
JOB_SECRET=change-me-to-a-long-random-string

# Platform defaults; each development can override both.
FAULT_OVERDUE_DAYS=30
DEFAULT_CURRENCY=NGN
