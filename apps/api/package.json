{
  "name": "@easytenant/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "bootstrap-admin": "tsx --env-file-if-exists=.env src/scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@easytenant/shared": "*",
    "@hono/node-server": "^2.1.5",
    "aws4fetch": "^1.0.20",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "mongodb-memory-server-core": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
